// Les enums reprennent les valeurs de @ticketing/shared : les garder synchronisés.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  READER
  AGENT_N1
  AGENT_N2
  ADMIN
  DEVELOPER
  EXTERNAL_USER
}

/// Mode d'attribution des tickets aux membres d'un groupe (CdC §3.3).
enum Distribution {
  ROUND_ROBIN
  LOAD
  MANUAL
}

enum SlaState {
  OK
  WARNING
  BREACHED
  PAUSED
  DONE
}

/// Canal d'arrivée d'un ticket ou d'un message (reporting par canal, CdC §7.2).
enum Channel {
  WEB
  EMAIL
}

enum InboundStatus {
  PROCESSED
  DUPLICATE
  AUTO_REPLY
  /// Newsletter, notification de réseau social, envoi de masse (en-têtes de liste de diffusion).
  BULK
  SPAM
  LOOP
  ERROR
}

enum OutboundStatus {
  PENDING
  SENT
  FAILED
  /// Aucun serveur SMTP configuré : le message a seulement été journalisé.
  SKIPPED
}

enum MeetingStatus {
  /// Créneaux proposés, en attente du choix du demandeur.
  PROPOSED
  SCHEDULED
  CANCELLED
}

/// Listes de qualification administrables (CdC §3.1).
enum OptionField {
  TYPE
  COMPONENT
  ENVIRONMENT
}

enum Impact {
  INDIVIDUAL
  TEAM
  ORGANIZATION
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Priority {
  P0
  P1
  P2
  P3
  P4
}

enum TicketStatus {
  NEW
  QUALIFYING
  WAITING_CUSTOMER
  SENT_TO_DEV
  IN_PROGRESS
  IN_QA
  READY_FOR_RELEASE
  RESOLVED
  CLOSED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  /// Absent pour un contact créé depuis un e-mail : aucune connexion possible.
  passwordHash String?
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requestedTickets  Ticket[]          @relation("requester")
  assignedTickets   Ticket[]          @relation("assignee")
  comments          Comment[]
  auditLogs         AuditLog[]
  organizedMeetings Meeting[]         @relation("organizer")
  meetingInvites    MeetingAttendee[]
  groupMemberships  GroupMember[]
  managedGroups     Group[]           @relation("manager")
  notifications     Notification[]
  incidentsOpened   Incident[]
  incidentUpdates   IncidentUpdate[]
}

model Ticket {
  /// Identifiant numérique lisible, utilisé dans les sujets d'email : [TICKET #12345].
  id                   Int          @id @default(autoincrement())
  subject              String
  description          String
  /// Clés de FieldOption (TYPE, COMPONENT, ENVIRONMENT), validées par l'API.
  type                 String       @default("QUESTION")
  component            String?
  environment          String?
  /// Valeurs des champs personnalisés, par clé de CustomField.
  customValues         Json         @default("{}")
  impact               Impact       @default(INDIVIDUAL)
  urgency              Urgency      @default(MEDIUM)
  priority             Priority
  /// Vrai lorsque la priorité a été forcée manuellement au lieu de suivre la matrice.
  priorityOverridden   Boolean      @default(false)
  status               TicketStatus @default(NEW)
  requesterId          String       @db.Uuid
  requester            User         @relation("requester", fields: [requesterId], references: [id])
  assigneeId           String?      @db.Uuid
  assignee             User?        @relation("assignee", fields: [assigneeId], references: [id])
  groupId              String?      @db.Uuid
  group                Group?       @relation(fields: [groupId], references: [id])
  /// État SLA recalculé à chaque modification et par la tâche de surveillance.
  slaState             SlaState     @default(OK)
  /// Échéance SLA la plus proche (null si aucune ne court).
  slaDueAt             DateTime?
  /// Ticket référent (« ticket problème ») auquel celui-ci est rattaché ; un seul niveau.
  parentId             Int?
  parent               Ticket?      @relation("referent", fields: [parentId], references: [id], onDelete: SetNull)
  children             Ticket[]     @relation("referent")
  /// Dernier message public du demandeur et dernière réponse publique du support.
  lastRequesterReplyAt DateTime?
  lastAgentReplyAt     DateTime?
  /// Vrai quand le demandeur s'est exprimé après la dernière réponse du support.
  awaitingAgent        Boolean      @default(false)
  channel              Channel      @default(WEB)
  /// Boîte de réception d'origine : les réponses partent depuis son adresse.
  mailboxId            String?      @db.Uuid
  mailbox              Mailbox?     @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  /// Ticket doublon fusionné dans un autre : les e-mails suivants y sont redirigés.
  mergedIntoId         Int?
  mergedInto           Ticket?      @relation("merge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom           Ticket[]     @relation("merge")
  firstResponseAt      DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  comments       Comment[]
  auditLogs      AuditLog[]
  tags           TicketTag[]
  meetings       Meeting[]
  slaPauses      SlaPause[]
  slaAlerts      SlaAlert[]
  notifications  Notification[]
  attachments    Attachment[]
  devLinks       DevLink[]
  incidents      Incident[]
  releaseItems   ReleaseItem[]
  /// Version de correction (« Fixed in v2.4.1 »), reprise de l'outil de développement.
  fixedInVersion String?
  outboundEmails OutboundEmail[]

  @@index([status])
  @@index([groupId])
  @@index([slaState, slaDueAt])
  @@index([parentId])
  @@index([awaitingAgent])
  @@index([priority])
  @@index([assigneeId])
  @@index([requesterId])
}

/// Outil de suivi des développements (Jira, GitHub) relié au support.
model DevIntegration {
  id           String      @id @default(uuid()) @db.Uuid
  provider     DevProvider
  name         String
  isActive     Boolean     @default(true)
  /// Jira : URL du site (https://acme.atlassian.net). GitHub : vide (api.github.com) ou URL d'API Enterprise.
  baseUrl      String?
  /// Jira : e-mail du compte porteur du jeton.
  account      String?
  /// Jeton d'API chiffré (AES-256-GCM) ; jamais renvoyé par l'API.
  tokenEnc     String?
  /// Jira : clé de projet (ex. APP). GitHub : dépôt « propriétaire/nom ».
  project      String
  /// Jira : type d'issue créé depuis un ticket (ex. Bug).
  issueType    String      @default("Bug")
  /// Statut externe (minuscules) → statut du ticket.
  statusMap    Json
  /// Jeton secret de l'URL du webhook entrant.
  webhookToken String      @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  links        DevLink[]
}

enum DevProvider {
  JIRA
  GITHUB
}

/// Issue externe liée à un ticket.
model DevLink {
  id             String         @id @default(uuid()) @db.Uuid
  ticketId       Int
  ticket         Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  integrationId  String         @db.Uuid
  integration    DevIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  /// Jira : PROJ-12. GitHub : owner/repo#34.
  externalKey    String
  url            String
  title          String
  externalStatus String?
  fixVersion     String?
  createdAt      DateTime       @default(now())
  syncedAt       DateTime?

  @@unique([integrationId, externalKey, ticketId])
  @@index([ticketId])
  @@index([integrationId, externalKey])
}

model Comment {
  id          String          @id @default(uuid()) @db.Uuid
  ticketId    Int
  ticket      Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String          @db.Uuid
  author      User            @relation(fields: [authorId], references: [id])
  body        String
  /// Note interne : invisible pour les utilisateurs externes.
  isInternal  Boolean         @default(false)
  channel     Channel         @default(WEB)
  /// Message-ID de l'e-mail reçu ou envoyé pour ce message (fil de discussion).
  messageId   String?         @unique
  attachments Attachment[]
  outbound    OutboundEmail[]
  createdAt   DateTime        @default(now())

  @@index([ticketId, createdAt])
}

/// Journal d'audit en ajout seul (CdC §7.3) : aucune route ne le modifie ni ne le supprime.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  Int?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id])
  /// Ex. ticket.created, ticket.updated, ticket.status_changed, comment.created.
  action    String
  /// Différences sous la forme { champ: { from, to } } ou charge utile de l'action.
  changes   Json?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Valeur d'une liste de qualification. Jamais supprimée une fois utilisée : on l'archive.
model FieldOption {
  id        String      @id @default(uuid()) @db.Uuid
  field     OptionField
  /// Code stable stocké sur les tickets ; seul le libellé est modifiable.
  key       String
  label     String
  position  Int
  isActive  Boolean     @default(true)
  /// Valeur dont dépend le comportement de l'application (ex. BUG, MAJOR_INCIDENT) : non archivable.
  isSystem  Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@unique([field, key])
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  /// Couleur d'affichage au format #rrggbb.
  color     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets TicketTag[]
}

model TicketTag {
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId    String @db.Uuid
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([ticketId, tagId])
  @@index([tagId])
}

/// Réglages globaux (matrice de priorité, mise en page…), un document JSON par clé.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Vue enregistrée de la barre latérale : un jeu de filtres nommé, partagé par le support.
model View {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  filters   Json
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Rendez-vous visio planifié depuis un ticket (CdC : modèle Calendly).
model Meeting {
  id              String        @id @default(uuid()) @db.Uuid
  ticketId        Int
  ticket          Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organizerId     String        @db.Uuid
  organizer       User          @relation("organizer", fields: [organizerId], references: [id])
  title           String
  durationMinutes Int
  status          MeetingStatus
  startsAt        DateTime?
  meetUrl         String?
  /// Fournisseur ayant créé l'événement (demo, google) et identifiant chez lui.
  provider        String
  providerEventId String?
  /// Jeton de la page publique de réservation (mode « proposer des créneaux »).
  bookingToken    String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  slots     MeetingSlot[]
  attendees MeetingAttendee[]

  @@index([ticketId])
}

model MeetingSlot {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @db.Uuid
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  startsAt  DateTime

  @@unique([meetingId, startsAt])
}

/// Participant invité en plus du demandeur et de l'organisateur (développeurs).
model MeetingAttendee {
  meetingId String  @db.Uuid
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id])

  @@id([meetingId, userId])
}

/// Réponse type avec variables et actions sur le ticket.
model Macro {
  id         String   @id @default(uuid()) @db.Uuid
  /// Identifiant des macros système (ex. meeting_scheduled) ; null pour les macros créées par l'administrateur.
  systemKey  String?  @unique
  name       String
  body       String
  isInternal Boolean  @default(false)
  /// { status?, addTagIds?, assignToMe? }
  actions    Json     @default("{}")
  position   Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Groupe d'agents (Support N1, N2, DevOps…) recevant les tickets routés.
model Group {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String       @unique
  description        String?
  distribution       Distribution @default(MANUAL)
  /// Responsable notifié des alertes SLA du groupe.
  managerId          String?      @db.Uuid
  manager            User?        @relation("manager", fields: [managerId], references: [id])
  /// Dernier agent servi par le tour de rôle.
  lastAssignedUserId String?      @db.Uuid
  isActive           Boolean      @default(true)
  position           Int
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  members   GroupMember[]
  tickets   Ticket[]
  rules     RoutingRule[]
  mailboxes Mailbox[]
}

model GroupMember {
  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

/// Règle de routage : la première règle active dont les conditions correspondent désigne le groupe.
model RoutingRule {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  /// { type?: string[], component?: string[], environment?: string[], priority?: Priority[] } ; vide = toujours.
  conditions Json     @default("{}")
  groupId    String   @db.Uuid
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  position   Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Période pendant laquelle le délai de résolution est suspendu (attente du client, ticket résolu).
model SlaPause {
  id        String    @id @default(uuid()) @db.Uuid
  ticketId  Int
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?

  @@index([ticketId])
}

/// Alerte SLA déjà émise, pour ne notifier qu'une fois par délai et par niveau.
model SlaAlert {
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// FIRST_RESPONSE ou RESOLUTION
  metric    String
  /// WARNING ou BREACHED
  level     String
  createdAt DateTime @default(now())

  @@id([ticketId, metric, level])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId  Int?
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Ex. sla.warning, sla.breached, ticket.assigned
  kind      String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/// Boîte de réception partagée (support@, incidents@, bugs@…), relevée en IMAP et/ou alimentée par webhook.
model Mailbox {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  address         String    @unique
  isActive        Boolean   @default(true)
  imapHost        String?
  imapPort        Int?
  imapSecure      Boolean   @default(true)
  imapUser        String?
  /// Mot de passe chiffré (AES-256-GCM) ; jamais renvoyé par l'API.
  imapPasswordEnc String?
  imapFolder      String    @default("INBOX")
  /// Curseur IMAP : UIDVALIDITY du dossier et dernier UID traité.
  uidValidity     BigInt?
  lastUid         Int?
  /// Jeton secret de l'URL de réception webhook.
  webhookToken    String    @unique
  /// Valeurs appliquées aux tickets créés par cette boîte (ex. bugs@ → type Bug).
  defaultType     String?
  defaultGroupId  String?   @db.Uuid
  defaultGroup    Group?    @relation(fields: [defaultGroupId], references: [id], onDelete: SetNull)
  lastCheckedAt   DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tickets Ticket[]
  inbound InboundEmail[]
}

/// Journal des e-mails reçus : un par Message-ID (déduplication), avec le sort qui lui a été réservé.
model InboundEmail {
  id          String        @id @default(uuid()) @db.Uuid
  mailboxId   String?       @db.Uuid
  mailbox     Mailbox?      @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  messageId   String        @unique
  fromAddress String
  subject     String
  status      InboundStatus
  reason      String?
  ticketId    Int?
  commentId   String?       @db.Uuid
  size        Int
  /// Message brut conservé pour les e-mails écartés ou en erreur (retraitement possible).
  rawKey      String?
  receivedAt  DateTime      @default(now())

  @@index([receivedAt])
  @@index([fromAddress, receivedAt])
}

/// File d'envoi des e-mails (réponses, accusés de réception), avec reprise en cas d'échec.
model OutboundEmail {
  id            String         @id @default(uuid()) @db.Uuid
  ticketId      Int
  ticket        Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId     String?        @db.Uuid
  comment       Comment?       @relation(fields: [commentId], references: [id], onDelete: SetNull)
  fromAddress   String
  toAddress     String
  subject       String
  body          String
  messageId     String         @unique
  inReplyTo     String?
  references    String?
  status        OutboundStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())

  @@index([status, nextAttemptAt])
  @@index([ticketId])
  @@index([commentId])
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     Int
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Message auquel la pièce est jointe ; null pour celles de la demande initiale.
  commentId    String?  @db.Uuid
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  filename     String
  contentType  String
  size         Int
  sha256       String
  storageKey   String   @unique
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  @@index([ticketId])
  @@index([commentId])
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  FIXING
  RESOLVED
}

enum AlertKind {
  SLACK
  TEAMS
  PAGERDUTY
  WEBHOOK
}

/// Incident majeur (P0/P1) : visible sur la status page publique et diffusé aux équipes d'astreinte.
model Incident {
  id          String              @id @default(uuid()) @db.Uuid
  title       String
  /// P0 ou P1.
  severity    Priority
  status      IncidentStatus      @default(INVESTIGATING)
  /// Ticket référent éventuel : l'incident ne crée aucun ticket par client.
  ticketId    Int?
  ticket      Ticket?             @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdById String              @db.Uuid
  createdBy   User                @relation(fields: [createdById], references: [id])
  startedAt   DateTime            @default(now())
  resolvedAt  DateTime?
  /// Post-mortem (PIR) : la chronologie se déduit des mises à jour.
  pmImpact    String?
  pmRootCause String?
  pmActions   String?
  updates     IncidentUpdate[]
  deliveries  AlertDelivery[]
  broadcasts  IncidentBroadcast[]

  @@index([status, startedAt])
  @@index([ticketId])
}

/// Message publié sur la status page à chaque changement de statut.
model IncidentUpdate {
  id         String         @id @default(uuid()) @db.Uuid
  incidentId String         @db.Uuid
  incident   Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  status     IncidentStatus
  message    String
  authorId   String         @db.Uuid
  author     User           @relation(fields: [authorId], references: [id])
  createdAt  DateTime       @default(now())

  @@index([incidentId, createdAt])
}

/// Destination d'alerte (Slack, Teams, PagerDuty, webhook générique).
model AlertChannel {
  id         String          @id @default(uuid()) @db.Uuid
  kind       AlertKind
  name       String
  isActive   Boolean         @default(true)
  /// URL du webhook, ou clé d'intégration PagerDuty ; chiffrée, jamais renvoyée par l'API.
  targetEnc  String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deliveries AlertDelivery[]
}

/// Journal des alertes envoyées : l'interface n'affiche « envoyée » que si elle l'a été.
model AlertDelivery {
  id         String       @id @default(uuid()) @db.Uuid
  incidentId String       @db.Uuid
  incident   Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  channelId  String       @db.Uuid
  channel    AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// opened, updated ou resolved.
  event      String
  ok         Boolean
  error      String?
  createdAt  DateTime     @default(now())

  @@index([incidentId, createdAt])
}

/// Diffusion groupée par e-mail aux clients impactés (aucun ticket individuel).
model IncidentBroadcast {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @db.Uuid
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  subject    String
  recipients Int
  sent       Int
  failed     Int
  /// Faux si aucun SMTP n'est configuré : les messages ont été journalisés, non envoyés.
  delivered  Boolean
  createdAt  DateTime @default(now())

  @@index([incidentId])
}

enum ReleaseStatus {
  DRAFT
  PUBLISHED
}

enum ReleaseCategory {
  NEW
  FIX
  ARCHITECTURE
}

/// Version de livraison : regroupe les tickets livrés et compile les notes.
model Release {
  id            String        @id @default(uuid()) @db.Uuid
  version       String        @unique
  title         String?
  status        ReleaseStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  publishedAt   DateTime?
  /// Nombre de demandeurs prévenus par e-mail à la publication (null : pas encore notifié).
  notifiedCount Int?
  items         ReleaseItem[]
}

model ReleaseItem {
  releaseId String          @db.Uuid
  release   Release         @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  ticketId  Int
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  category  ReleaseCategory
  /// Résumé vulgarisé pour les clients ; sans résumé, le ticket reste dans les notes techniques seulement.
  summary   String?

  @@id([releaseId, ticketId])
  @@index([ticketId])
}

enum CustomFieldKind {
  TEXT
  LONGTEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

/// Champ de ticket défini par l'administrateur. Archivé (jamais supprimé) pour conserver les valeurs existantes.
model CustomField {
  id           String          @id @default(uuid()) @db.Uuid
  /// Clé stable des valeurs stockées sur les tickets ; non modifiable.
  key          String          @unique
  label        String
  kind         CustomFieldKind
  /// Choix d'une liste (SELECT), tableau de chaînes.
  options      Json            @default("[]")
  /// Obligatoire à la création du ticket.
  required     Boolean         @default(false)
  /// Visible et saisissable par le demandeur (utilisateur externe) à la création.
  forRequester Boolean         @default(false)
  position     Int
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
}
