// Les enums reprennent les valeurs de @ticketing/shared : les garder synchronisés.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  READER
  AGENT_N1
  AGENT_N2
  ADMIN
  DEVELOPER
  EXTERNAL_USER
}

enum MeetingStatus {
  /// Créneaux proposés, en attente du choix du demandeur.
  PROPOSED
  SCHEDULED
  CANCELLED
}

/// Listes de qualification administrables (CdC §3.1).
enum OptionField {
  TYPE
  COMPONENT
  ENVIRONMENT
}

enum Impact {
  INDIVIDUAL
  TEAM
  ORGANIZATION
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Priority {
  P0
  P1
  P2
  P3
  P4
}

enum TicketStatus {
  NEW
  QUALIFYING
  SENT_TO_DEV
  IN_PROGRESS
  IN_QA
  READY_FOR_RELEASE
  RESOLVED
  CLOSED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requestedTickets  Ticket[]          @relation("requester")
  assignedTickets   Ticket[]          @relation("assignee")
  comments          Comment[]
  auditLogs         AuditLog[]
  organizedMeetings Meeting[]         @relation("organizer")
  meetingInvites    MeetingAttendee[]
}

model Ticket {
  /// Identifiant numérique lisible, utilisé dans les sujets d'email : [TICKET #12345].
  id                 Int          @id @default(autoincrement())
  subject            String
  description        String
  /// Clés de FieldOption (TYPE, COMPONENT, ENVIRONMENT), validées par l'API.
  type               String       @default("QUESTION")
  component          String?
  environment        String?
  impact             Impact       @default(INDIVIDUAL)
  urgency            Urgency      @default(MEDIUM)
  priority           Priority
  /// Vrai lorsque la priorité a été forcée manuellement au lieu de suivre la matrice.
  priorityOverridden Boolean      @default(false)
  status             TicketStatus @default(NEW)
  requesterId        String       @db.Uuid
  requester          User         @relation("requester", fields: [requesterId], references: [id])
  assigneeId         String?      @db.Uuid
  assignee           User?        @relation("assignee", fields: [assigneeId], references: [id])
  firstResponseAt    DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  comments  Comment[]
  auditLogs AuditLog[]
  tags      TicketTag[]
  meetings  Meeting[]

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([requesterId])
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   Int
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String   @db.Uuid
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  /// Note interne : invisible pour les utilisateurs externes.
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Journal d'audit en ajout seul (CdC §7.3) : aucune route ne le modifie ni ne le supprime.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  Int?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id])
  /// Ex. ticket.created, ticket.updated, ticket.status_changed, comment.created.
  action    String
  /// Différences sous la forme { champ: { from, to } } ou charge utile de l'action.
  changes   Json?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Valeur d'une liste de qualification. Jamais supprimée une fois utilisée : on l'archive.
model FieldOption {
  id        String      @id @default(uuid()) @db.Uuid
  field     OptionField
  /// Code stable stocké sur les tickets ; seul le libellé est modifiable.
  key       String
  label     String
  position  Int
  isActive  Boolean     @default(true)
  /// Valeur dont dépend le comportement de l'application (ex. BUG, MAJOR_INCIDENT) : non archivable.
  isSystem  Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@unique([field, key])
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  /// Couleur d'affichage au format #rrggbb.
  color     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets TicketTag[]
}

model TicketTag {
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId    String @db.Uuid
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([ticketId, tagId])
  @@index([tagId])
}

/// Réglages globaux (matrice de priorité, mise en page…), un document JSON par clé.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Vue enregistrée de la barre latérale : un jeu de filtres nommé, partagé par le support.
model View {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  filters   Json
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Rendez-vous visio planifié depuis un ticket (CdC : modèle Calendly).
model Meeting {
  id              String        @id @default(uuid()) @db.Uuid
  ticketId        Int
  ticket          Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organizerId     String        @db.Uuid
  organizer       User          @relation("organizer", fields: [organizerId], references: [id])
  title           String
  durationMinutes Int
  status          MeetingStatus
  startsAt        DateTime?
  meetUrl         String?
  /// Fournisseur ayant créé l'événement (demo, google) et identifiant chez lui.
  provider        String
  providerEventId String?
  /// Jeton de la page publique de réservation (mode « proposer des créneaux »).
  bookingToken    String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  slots     MeetingSlot[]
  attendees MeetingAttendee[]

  @@index([ticketId])
}

model MeetingSlot {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @db.Uuid
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  startsAt  DateTime

  @@unique([meetingId, startsAt])
}

/// Participant invité en plus du demandeur et de l'organisateur (développeurs).
model MeetingAttendee {
  meetingId String  @db.Uuid
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id])

  @@id([meetingId, userId])
}

/// Réponse type avec variables et actions sur le ticket.
model Macro {
  id         String   @id @default(uuid()) @db.Uuid
  /// Identifiant des macros système (ex. meeting_scheduled) ; null pour les macros créées par l'administrateur.
  systemKey  String?  @unique
  name       String
  body       String
  isInternal Boolean  @default(false)
  /// { status?, addTagIds?, assignToMe? }
  actions    Json     @default("{}")
  position   Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
