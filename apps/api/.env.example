NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://ticketing:ticketing@localhost:5432/ticketing?schema=public
# Au moins 32 caractères. Générer avec : openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=8h

# Compte administrateur créé par `npm run db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please

# Tentatives de connexion par minute et par IP
LOGIN_RATE_LIMIT=10
