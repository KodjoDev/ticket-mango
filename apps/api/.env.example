NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://ticketing:ticketing@localhost:5432/ticketing?schema=public
# Au moins 32 caractères. Générer avec : openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=8h

# Compte administrateur créé par `npm run db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please

# Tentatives de connexion par minute et par IP
LOGIN_RATE_LIMIT=10

# Cookie de session réservé à HTTPS (true par défaut en production)
COOKIE_SECURE=false

# Liens publics (réservation de créneaux) et fuseau des messages générés
PUBLIC_APP_URL=http://localhost:5173
APP_TIMEZONE=Europe/Paris
# Visioconférence : demo (liens fictifs) tant que Google n’est pas configuré
MEETING_PROVIDER=demo

# Correcteur orthographique et grammatical (LanguageTool auto-hébergé, voir docker-compose)
# LANGUAGETOOL_URL=http://localhost:8010

# Messagerie (lot 4)
# Clé de chiffrement des mots de passe IMAP : openssl rand -base64 32
# SECRET_KEY=
# Envoi SMTP ; sans valeur, les e-mails sont seulement journalisés. En développement : Mailpit (docker compose).
# SMTP_URL=smtp://localhost:1025
# EMAIL_FROM=support@example.com
EMAIL_FROM_NAME=Support
# URL publique de l'API pour les webhooks de réception (défaut : PUBLIC_APP_URL/api)
# PUBLIC_API_URL=https://support.example.com/api
STORAGE_DIR=./data
