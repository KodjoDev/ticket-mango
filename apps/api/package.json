{
  "name": "@ticketing/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@prisma/client": "~6.19.3",
    "@ticketing/shared": "0.1.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "html-to-text": "10.0.1",
    "imapflow": "2.4.0",
    "mailparser": "3.9.47",
    "nodemailer": "10.1.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "pino-pretty": "^13.2.0",
    "prisma": "~6.19.3",
    "tsx": "^4.23.15"
  }
}
